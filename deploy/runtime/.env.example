# ==============================================================================
# TwinBot 执行机 Docker Compose 环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# ==============================================================================

# 控制服务器对外提供的安全 WSS 地址
CONTROL_WS_URL=wss://control.yourdomain.com/v1/ws

# 用户 A 对应的云端 Pod 鉴权 Token（必须与控制服务器 CLOUD_RUNTIME_TOKENS_JSON 中的一致）
RUNTIME_TOKEN_USER_A=sec-runtime-token-a-32-chars-long-pod-1

# 用户 B 对应的云端 Pod 鉴权 Token（必须与控制服务器 CLOUD_RUNTIME_TOKENS_JSON 中的一致）
RUNTIME_TOKEN_USER_B=sec-runtime-token-b-32-chars-long-pod-2

# 可选：Brave Search API Key（https://api.search.brave.com 申请）。
# 未配置时 web.search 自动回退 DuckDuckGo HTML 解析（免 Key，稳定性略低）。
WEB_SEARCH_API_KEY=
