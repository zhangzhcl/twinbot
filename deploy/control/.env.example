# ==============================================================================
# TwinBot 控制服务器 (2C4G) 生产环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# 注意：严禁将包含真实凭证的 .env 提交至代码仓库！
# ==============================================================================

# 运行环境
NODE_ENV=production

# 节点角色：all (单机网关与Worker一体化) | gateway (仅HTTP/WSS网关) | worker (仅后台推理Worker)
SERVER_ROLE=all

# 监听配置
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8787

# 数据库配置（PostgreSQL）
POSTGRES_DB=twinbot
POSTGRES_USER=twinbot
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgres://twinbot:replace-with-a-strong-postgres-password@postgres:5432/twinbot

# 用户身份凭证映射（JSON 格式：token 必须大于等于 32 字符且无空白）
# 生成随机高熵 Token 示例命令：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CONTROL_TOKENS_JSON={"sec-user-token-a-minimum-32-chars-long-example":"user-a","sec-user-token-b-minimum-32-chars-long-example":"user-b"}

# 云端 Runtime Pod 身份凭证映射（JSON 格式：绑定专属 userId 与 podId）
CLOUD_RUNTIME_TOKENS_JSON={"sec-runtime-token-a-32-chars-long-pod-1":{"userId":"user-a","podId":"pod-1"},"sec-runtime-token-b-32-chars-long-pod-2":{"userId":"user-b","podId":"pod-2"}}

# 大模型推理配置 (使用 Pi Coding Agent SDK)
# 支持 openai-compatible 或指定服务商
AGENT_PROVIDER=openai-compatible
AGENT_MODEL=gpt-4o
AGENT_API_KEY=sk-your-model-api-key-here
AGENT_API_BASE_URL=https://api.openai.com/v1

# 任务并发与超时
# 针对 2C4G 服务器，推荐 Agent 并发度设为 2~4
AGENT_CONCURRENCY=2
AGENT_TIMEOUT_MS=120000
