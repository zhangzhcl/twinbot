NODE_ENV=development
DATABASE_URL=postgresql://twinbot:change-me@127.0.0.1:5432/twinbot
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8787
CONTROL_DEV_TOKENS_JSON={"dev-token":"local-dev-user","user-b-token":"user-b"}
# Production only: map unique random tokens (at least 32 characters) to user IDs.
# CONTROL_TOKENS_JSON={"<random-token>":"user-id"}
# Optional: map Pod-specific random tokens (at least 32 characters) to their fixed owner and pod identity.
# CLOUD_RUNTIME_TOKENS_JSON={"<random-runtime-token>":{"userId":"user-id","podId":"pod-id"}}
AGENT_CONCURRENCY=1
# 建议不低于 300000：vcs.checkpoint / code.run 等长任务工具依赖该上限
AGENT_TIMEOUT_MS=300000
# Pi Agent SDK v1.4.0; Node.js >=22.19.0 is required.
# Leave key/model unset to keep runs queued.
# AGENT_PROVIDER=openai-compatible
# AGENT_API_BASE_URL=https://api.openai.com/v1
# AGENT_API_KEY=replace-me
# AGENT_MODEL=gpt-4o-mini

# Cloud Runtime 工具环境变量（在 deploy/runtime/.env 或 k3s Pod 编排中配置）：
# WEB_SEARCH_API_KEY=      # 可选：Brave Search API Key，缺省回退 DuckDuckGo
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium   # browser.use 使用的 Chromium（镜像内已内置）

# 产物预览公网基础地址（浏览器经此地址访问 /p/<token>/ 路由；需与实际对外协议/域名/端口一致）
# PREVIEW_PUBLIC_BASE_URL=https://your-domain:8787

# Optional AES-256 key for encrypting model API keys at rest (64 hex chars or any passphrase).
# Without it, keys are still masked in API responses but stored as plaintext in Postgres.
# MODEL_SECRETS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
